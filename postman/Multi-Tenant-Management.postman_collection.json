{
  "info": {
    "_postman_id": "a7c3e1b0-4d2f-4c8a-9f11-multi-tenant-api",
    "name": "Multi-Tenant Task Platform",
    "description": "Keycloak password-grant demo collection. There is no /api/auth/login. Get Token, then Me, then create org/project/task.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "keycloakUrl", "value": "http://localhost:8081" },
    { "key": "token", "value": "" },
    { "key": "organizationId", "value": "1" },
    { "key": "projectId", "value": "1" },
    { "key": "taskId", "value": "1" },
    { "key": "taskVersion", "value": "0" }
  ],
  "item": [
    {
      "name": "Health",
      "item": [
        {
          "name": "Liveness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health/liveness"
          }
        },
        {
          "name": "Readiness",
          "request": {
            "method": "GET",
            "header": [],
            "url": "{{baseUrl}}/actuator/health/readiness"
          }
        }
      ]
    },
    {
      "name": "Keycloak",
      "item": [
        {
          "name": "Get Token (alice)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('token', json.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/x-www-form-urlencoded" }],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "grant_type", "value": "password" },
                { "key": "client_id", "value": "task-web" },
                { "key": "username", "value": "alice" },
                { "key": "password", "value": "Password123" }
              ]
            },
            "url": "{{keycloakUrl}}/realms/taskmgr/protocol/openid-connect/token"
          }
        }
      ]
    },
    {
      "name": "Identity",
      "item": [
        {
          "name": "Me",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/me"
          }
        }
      ]
    },
    {
      "name": "Organizations",
      "item": [
        {
          "name": "Create organization",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('organizationId', String(pm.response.json().id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Acme\",\n  \"slug\": \"acme\"\n}"
            },
            "url": "{{baseUrl}}/api/organizations"
          }
        },
        {
          "name": "List members",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
            "url": "{{baseUrl}}/api/organizations/{{organizationId}}/members"
          }
        },
        {
          "name": "Audit logs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "X-Organization-Id", "value": "{{organizationId}}" }
            ],
            "url": "{{baseUrl}}/api/organizations/{{organizationId}}/audit-logs?page=0&size=20"
          }
        }
      ]
    },
    {
      "name": "Work",
      "item": [
        {
          "name": "Create project",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('projectId', String(pm.response.json().id));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Organization-Id", "value": "{{organizationId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Website\"\n}"
            },
            "url": "{{baseUrl}}/api/projects"
          }
        },
        {
          "name": "Create task",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200 || pm.response.code === 201) {",
                  "  const json = pm.response.json();",
                  "  pm.collectionVariables.set('taskId', String(json.id));",
                  "  pm.collectionVariables.set('taskVersion', String(json.version));",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Organization-Id", "value": "{{organizationId}}" },
              { "key": "Idempotency-Key", "value": "{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"title\": \"First task\"\n}"
            },
            "url": "{{baseUrl}}/api/projects/{{projectId}}/tasks"
          }
        },
        {
          "name": "List tasks",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "X-Organization-Id", "value": "{{organizationId}}" }
            ],
            "url": "{{baseUrl}}/api/projects/{{projectId}}/tasks?page=0&size=20"
          }
        },
        {
          "name": "Update task",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Organization-Id", "value": "{{organizationId}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"status\": \"IN_PROGRESS\",\n  \"version\": {{taskVersion}}\n}"
            },
            "url": "{{baseUrl}}/api/projects/{{projectId}}/tasks/{{taskId}}"
          }
        },
        {
          "name": "Dashboard",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "X-Organization-Id", "value": "{{organizationId}}" }
            ],
            "url": "{{baseUrl}}/api/analytics/dashboard"
          }
        }
      ]
    }
  ]
}
