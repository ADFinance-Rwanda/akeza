{
  "realm": "taskmgr",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      { "name": "user" },
      { "name": "SUPER_ADMIN" }
    ]
  },
  "clients": [
    {
      "clientId": "task-web",
      "publicClient": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "redirectUris": ["http://localhost:8088/*", "http://localhost:5173/*"],
      "webOrigins": ["http://localhost:8088", "http://localhost:5173"],
      "protocol": "openid-connect",
      "protocolMappers": [
        {
          "name": "audience-task-api",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "config": {
            "included.client.audience": "task-api",
            "id.token.claim": "false",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "task-api",
      "bearerOnly": true,
      "protocol": "openid-connect"
    }
  ],
  "users": [
    {
      "username": "alice",
      "enabled": true,
      "email": "alice@example.com",
      "emailVerified": true,
      "firstName": "Alice",
      "lastName": "Admin",
      "credentials": [{ "type": "password", "value": "Password123", "temporary": false }],
      "realmRoles": ["user"]
    },
    {
      "username": "bob",
      "enabled": true,
      "email": "bob@example.com",
      "emailVerified": true,
      "firstName": "Bob",
      "lastName": "Builder",
      "credentials": [{ "type": "password", "value": "Password123", "temporary": false }],
      "realmRoles": ["user"]
    },
    {
      "username": "carol",
      "enabled": true,
      "email": "carol@example.com",
      "emailVerified": true,
      "firstName": "Carol",
      "lastName": "Member",
      "credentials": [{ "type": "password", "value": "Password123", "temporary": false }],
      "realmRoles": ["user"]
    },
    {
      "username": "dave",
      "enabled": true,
      "email": "dave@example.com",
      "emailVerified": true,
      "firstName": "Dave",
      "lastName": "Member",
      "credentials": [{ "type": "password", "value": "Password123", "temporary": false }],
      "realmRoles": ["user"]
    },
    {
      "username": "erin",
      "enabled": true,
      "email": "erin@example.com",
      "emailVerified": true,
      "firstName": "Erin",
      "lastName": "Super",
      "credentials": [{ "type": "password", "value": "Password123", "temporary": false }],
      "realmRoles": ["user", "SUPER_ADMIN"]
    }
  ]
}
